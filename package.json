{
  "name": "propresenter-ai-studio",
  "version": "3.0.0",
  "description": "CapyWorship (MULTIMEDIOS • Tech for the Kingdom) — Estación de control multimedia de escritorio para proyección multipantalla, salida nativa de Videowall, transmisión en vivo (OBS/Resolume), monitor de escenario, calendario de eventos y gestor de escrituras.",
  "main": "main.js",
  "author": "ProPresenter AI Studio Team",
  "license": "MIT",
  "keywords": [
    "propresenter",
    "worship-presentation",
    "live-projection",
    "electron",
    "stage-display",
    "bible-importer",
    "worship-software"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node tests/smoke-test.mjs",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "package:exe": "npm run build && electron-packager . \"CapyWorship\" --platform=win32 --arch=x64 --out=release-builds --overwrite"
  },
  "build": {
    "appId": "com.propresenter.aistudio",
    "productName": "CapyWorship",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "Branding/**/*",
      "appsettings.json",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "icon": "Branding/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CapyWorship",
      "installerIcon": "Branding/icon.ico",
      "uninstallerIcon": "Branding/icon.ico",
      "installerHeaderIcon": "Branding/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "lucide": "^1.72.0",
    "pdfjs-dist": "^5.7.284"
  }
}